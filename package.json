{
  "name": "blockchain",
  "version": "0.4.0",
  "private": true,
  "description": "Interactive Blockchain",
  "license": "MIT",
  "keywords": [
    "blockchain",
    "sha-256",
    "visualization",
    "mining-simulation",
    "merkle-tree",
    "rsa",
    "nextjs",
    "ai",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "network": "node scripts/p8-network/run.mjs",
    "slides:dev": "npm run dev --prefix slides",
    "slides:build": "npm run build --prefix slides",
    "slides:export": "npm run export --prefix slides",
    "dev:all": "concurrently \"npm run dev\" \"npm run slides:dev\""
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
